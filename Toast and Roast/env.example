# Copy these names into Vercel > Project > Settings > Environment Variables.
# NEVER commit real values.
PROVIDER=anthropic        # anthropic | openai | xai
API_KEY=
ACCESS_CODE=              # shared passcode users type into the app
MODEL=                    # optional override, e.g. claude-sonnet-4-5
DAILY_LIMIT=100           # optional: total generations per day
PER_IP_LIMIT=10           # optional: generations per IP per hour
